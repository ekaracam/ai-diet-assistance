# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` git'e GİRMEZ.
# Gerçek anahtarları asla kaynak dosyalara yazmayın.

# ── Gemini ───────────────────────────────────────────────────────────────────
# Yalnızca web-frontend/.env.local içinde gereklidir (sunucu tarafı).
# NEXT_PUBLIC_ / EXPO_PUBLIC_ öneki KULLANMAYIN — o önek anahtarı istemci
# paketine gömer ve herkese açık hale getirir.
GEMINI_API_KEY=

# ── Next.js API route adresi ─────────────────────────────────────────────────
# Gemini çağrıları buraya gider. Mobil derleme için ZORUNLU:
# boş bırakılırsa APK localhost'a (telefonun kendisine) istek atar ve
# tüm AI özellikleri çalışmaz.
# Örnek: https://ai-diyet.vercel.app
EXPO_PUBLIC_API_URL=

# ── Firebase (istemci config — herkese açık olması normaldir) ─────────────────
# Erişim kontrolü API anahtarıyla değil firestore.rules ile sağlanır.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
